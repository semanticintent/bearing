<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Bearing.Mcp</RootNamespace>
    <AssemblyName>bearing-mcp</AssemblyName>
  </PropertyGroup>

  <!-- No RuntimeIdentifier pinned here on purpose: this server has no OS specific
       code, so "dotnet build" and "dotnet run" stay portable across Windows, macOS,
       and Linux. For a single file publish targeting one specific machine, pass
       the RID explicitly at publish time, for example:
         dotnet publish -c Release -r win-x64 -p:SelfContained=false -p:PublishSingleFile=true
         dotnet publish -c Release -r osx-arm64 -p:SelfContained=false -p:PublishSingleFile=true
         dotnet publish -c Release -r linux-x64 -p:SelfContained=false -p:PublishSingleFile=true -->

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="1.4.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bearing.Core\Bearing.Core.csproj" />
  </ItemGroup>

</Project>
